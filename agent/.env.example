# ============================================================
# vigiAI Agent v2 — Configuração de Ambiente
# ============================================================
# Copie este arquivo para .env e preencha com seus dados
# cp .env.example .env

# ============================================================
# 📧 EMAIL: Notificação de Aprovação (Gmail)
# ============================================================
# Obrigatório para envio de email

# Seu email Gmail
EMAIL_USER=seu-email@gmail.com

# App Password (NÃO é sua senha da conta)
# Gere em: https://myaccount.google.com/apppasswords
# 1. Ative 2FA
# 2. Vá para App Passwords
# 3. Selecione: Mail + Windows Computer
# 4. Copie a senha gerada (16 caracteres)
EMAIL_PASSWORD=sosp dmhb nrxv tkhv

# ============================================================
# 📱 WHATSAPP: Notificação via Z-API
# ============================================================
# Obrigatório para envio de WhatsApp

# Número do WhatsApp que receberá notificações
# Formato: 55 + DDD + NÚMERO (ex: 5511991989415)
WHATSAPP_PHONE=5511991989415

# Credenciais Z-API
# Cadastre-se em: https://z-api.io/
# Crie uma instância e copie:
ZAPI_INSTANCE_ID=sua-instance-id-aqui
ZAPI_TOKEN=seu-token-aqui
ZAPI_CLIENT_TOKEN=seu-client-token-aqui

# ============================================================
# 🤖 LLM: Identificação Inteligente de Documentos
# ============================================================
# Opcional: melhora a precisão na identificação de editais
# Se não configurado, usa fallback com regex e keywords

# Chave API OpenRouter (oferece tier free)
# Obtenha em: https://openrouter.ai/
# Modelo usado: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_API_KEY=sk-or-v1-seu-token-aqui

# ============================================================
# 🌐 SUPABASE: Armazenamento de Resultados (Opcional)
# ============================================================
# Não usado no agent v2 ainda, mas necessário para integração futura

SUPABASE_URL=https://hrrgfecztjgpyekncfcs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_chave_aqui

# ============================================================
# 🏙️ CONFIGURAÇÃO DA BUSCA
# ============================================================
# Estes valores estão hardcoded em agent-v2.cjs, mas você pode editá-los:
# - searchCity: "Santos"
# - searchNumber: "11659"
# - searchName: "JOSUEL DE JESUS MIRANDA"
# - baseUrl: "https://www.ibamsp-concursos.org.br"
