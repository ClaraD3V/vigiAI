# Porta da API HTTP do agente
PORT=3001

# Agendamento (cron). Padrão: todo dia às 19:00
CRON_DAILY_CHECK=0 19 * * *

# Limiar mínimo de confiança (0-1) para considerar um match e notificar
CONFIDENCE_THRESHOLD=0.9

# Cidade padrão no IBAM Concursos quando o candidato não informa candidato.cidade
IBAM_CIDADE_PADRAO=Santos

# LLM opcional, compatível com a API da OpenRouter.
# Sem OPENROUTER_API_KEY definido, o agente usa só regras determinísticas (sem custo de tokens).
OPENROUTER_API_KEY=
# Modelo gratuito (sufixo ":free"). A disponibilidade muda com frequência —
# confira https://openrouter.ai/models?max_price=0 antes de usar em produção.
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Supabase — usado só para alimentar o dashboard do front (leitura).
# service_role key é secreta: nunca exponha no front, só uso server-side aqui.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API (Meta). Sem essas variáveis, o envio é apenas simulado/logado.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v20.0
# Nome do template aprovado no Meta Business Manager para iniciar conversa fora da janela de 24h
WHATSAPP_TEMPLATE_NAME=vigiai_notificacao
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
