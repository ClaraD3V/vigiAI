# ============================================================
# vigiAI - Configuração Central
# ============================================================
# IMPORTANTE: Copie este arquivo para .env (não commitar!)
# cp .env.example .env
#
# Este arquivo centraliza TODAS as configurações
# Não crie .env em subdiretórios (ex: agent/)
# ============================================================

# ============================================================
# AMBIENTE
# ============================================================
NODE_ENV=development
PORT=3001

# ============================================================
# IBAMSP - Busca de Editais
# ============================================================
IBAM_CIDADE_PADRAO=Santos

# ============================================================
# EMAIL - Notificação (OBRIGATÓRIO)
# ============================================================
# Enviar notificações via Gmail
#
# Como gerar App Password:
# 1. Acesse: https://myaccount.google.com/apppasswords
# 2. Ative 2FA (se não tiver)
# 3. Selecione: Mail + Windows Computer
# 4. Copie a senha gerada (16 caracteres)
#
EMAIL_USER=seu-email@gmail.com
EMAIL_PASSWORD=sua-app-password-16-caracteres

# ============================================================
# LLM - Melhor Identificação de Documentos (OPCIONAL)
# ============================================================
# Usar inteligência artificial para encontrar documentos
# Se deixar vazio, usa busca por palavras-chave
#
# Obter em: https://openrouter.ai/
# Modelos gratuitos disponíveis
#
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ============================================================
# SUPABASE - Armazenamento (OPCIONAL)
# ============================================================
# Guardar resultados em banco de dados
# Se não configurar, resultados apenas em console
#
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
