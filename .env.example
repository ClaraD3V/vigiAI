# Supabase (Backend - Agent only)
# Get from: https://app.supabase.com → Project Settings → API Keys
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_... (service_role_key, NEVER expose in frontend)

# Supabase (Frontend public key)
# Get from: https://app.supabase.com → Project Settings → API Keys
SUPABASE_ANON_KEY=eyJ... (anon/publishable key)

# OpenRouter LLM API
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# WhatsApp Integration (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=vigiai_notificacao

# Environment
NODE_ENV=development
PORT=3001

# Monitoring/Alerts (optional)
CRON_DAILY_CHECK=0 19 * * *
CONFIDENCE_THRESHOLD=0.9
